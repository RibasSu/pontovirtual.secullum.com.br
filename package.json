{
  "name": "ponto-virtual-secullum-desktop",
  "version": "1.0.0",
  "description": "Aplicativo desktop para o Ponto Virtual Secullum.",
  "main": "src/main.js",
  "author": "Ponto Virtual Secullum",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/RibasSu/pontovirtual.secullum.com.br.git"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:win:zip": "electron-builder --win zip",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:linux:tar": "electron-builder --linux tar.gz",
    "dist:all": "bun run dist:win && bun run dist:linux",
    "dist:release": "electron-builder --win nsis --linux AppImage deb --publish always"
  },
  "build": {
    "appId": "br.com.secullum.pontovirtual",
    "productName": "Ponto Virtual Secullum",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RibasSu",
        "repo": "pontovirtual.secullum.com.br"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Office",
      "icon": "build/icons",
      "maintainer": "Ponto Virtual Secullum <noreply@secullum.com.br>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ponto Virtual Secullum"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
