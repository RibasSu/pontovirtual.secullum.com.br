{
  "name": "ponto-virtual-secullum-desktop",
  "version": "1.0.0",
  "description": "Aplicativo desktop para o Ponto Virtual Secullum.",
  "main": "src/main.js",
  "author": "Ponto Virtual Secullum",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win zip",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:linux:tar": "electron-builder --linux tar.gz",
    "dist:all": "bun run dist:win && bun run dist:linux",
    "dist:win:installer": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "br.com.secullum.pontovirtual",
    "productName": "Ponto Virtual Secullum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "zip"
      ]
    },
    "linux": {
      "category": "Office",
      "maintainer": "Ponto Virtual Secullum <noreply@secullum.com.br>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ponto Virtual Secullum"
    }
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  }
}
